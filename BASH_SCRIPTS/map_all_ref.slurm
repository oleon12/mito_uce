#!/usr/bin/env bash
#SBATCH --job-name=map_all_ref
#SBATCH --partition=main
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=48:00:00
#SBATCH --output=/scratch/odl7/sturnira_mito/LOG/map_all_ref_%j.out
#SBATCH --error=/scratch/odl7/sturnira_mito/ERR_OUT/map_all_ref_%j.err
#SBATCH --mail-user=odl7@scarletmail.rutgers.edu
#SBATCH --mail-type=END,FAIL

set -euo pipefail

############################################
# PURPOSE
############################################
# Map paired-end UCE/off-target reads to one mitochondrial reference and
# produce one coordinate-sorted, indexed, duplicate-MARKED BAM per sample.
#
# Final BAM:
#   results/SAMPLE/bam/SAMPLE.mapped.bam
#
# The final BAM contains only primary, mapped, QC-passed alignments.
# PCR/optical duplicates are marked with flag 0x400 but are NOT removed.
# Downstream depth and variant-calling steps can therefore exclude duplicate
# evidence while the original alignments remain auditable.
#
# This revision does not retain the very large all-read SAMPLE.sorted.bam
# generated by the previous script.

############################################
# CONFIGURATION
############################################
WORKDIR="/scratch/odl7/sturnira_mito"
CONDA_ENV="mt_pipeline"

SAMPLE_LIST="CONFS/sample_list.txt"
REF="references/S_ludovici_QCAZ_18312.fasta"
RESULTS_DIR="results"

THREADS="${SLURM_CPUS_PER_TASK:-8}"
SORT_THREADS=2
SORT_MEMORY_PER_THREAD="2G"

DEFAULT_PLATFORM="ILLUMINA"

# Full paired-FASTQ validation reads each input once before mapping. This adds
# I/O but detects truncation, malformed records, unequal mate counts, and
# mismatched read names before BWA starts.
VALIDATE_FASTQ_PAIRS="true"

# false: validate and skip a current publication-format BAM; fail on an
# incompatible old BAM. true: rebuild BAMs from FASTQ.
OVERWRITE="false"

# Exclude during mapping output:
#   0x4   UNMAP
#   0x100 SECONDARY
#   0x200 QCFAIL
#   0x800 SUPPLEMENTARY
EXCLUDE_FLAGS=2820

############################################
# ENVIRONMENT
############################################
cd "$WORKDIR"

source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate "$CONDA_ENV"

for command_name in python3 bwa samtools; do
    command -v "$command_name" >/dev/null 2>&1 || {
        echo "ERROR: $command_name was not found in $CONDA_ENV." >&2
        exit 1
    }
done

echo "BWA version:"
bwa 2>&1 | awk '/Version:/ {print; exit}' || true
echo "SAMtools version:"
samtools --version | head -n 1

############################################
# THREAD ALLOCATION
############################################
if (( THREADS < 4 )); then
    echo "ERROR: request at least 4 CPUs for this mapping workflow." >&2
    exit 1
fi

if (( SORT_THREADS >= THREADS )); then
    SORT_THREADS=1
fi

BWA_THREADS=$((THREADS - SORT_THREADS))

############################################
# RESOLVE AND CHECK PATHS
############################################
SAMPLE_LIST=$(realpath "$SAMPLE_LIST")
REF=$(realpath "$REF")
RESULTS_DIR=$(realpath -m "$RESULTS_DIR")

for file in "$SAMPLE_LIST" "$REF"; do
    [[ -s "$file" ]] || {
        echo "ERROR: required input missing or empty: $file" >&2
        exit 1
    }
done

for suffix in amb ann bwt pac sa; do
    [[ -s "${REF}.${suffix}" ]] || {
        echo "ERROR: missing BWA index component: ${REF}.${suffix}" >&2
        echo "Run prep_ref.slurm before mapping." >&2
        exit 1
    }
done

[[ -s "${REF}.fai" ]] || samtools faidx "$REF"

mkdir -p "$RESULTS_DIR"

############################################
# HELPERS
############################################
validate_sample_name() {
    local sample="$1"

    if [[ ! "$sample" =~ ^[A-Za-z0-9._-]+$ ]]; then
        echo "ERROR: unsafe sample identifier '$sample'." >&2
        echo "Use only letters, numbers, periods, underscores, and hyphens." >&2
        return 1
    fi
}

validate_fastq_pair() {
    local read1="$1"
    local read2="$2"

    python3 - "$read1" "$read2" <<'PY'
import gzip
import sys
from itertools import zip_longest
from pathlib import Path

r1_path = Path(sys.argv[1])
r2_path = Path(sys.argv[2])


def open_text(path):
    if str(path).lower().endswith(".gz"):
        return gzip.open(str(path), "rt")
    return path.open("r")


def normalize_name(header):
    name = header[1:].strip().split()[0]
    if name.endswith("/1") or name.endswith("/2"):
        name = name[:-2]
    return name


def records(handle, path):
    record_number = 0

    while True:
        header = handle.readline()

        if header == "":
            return

        sequence = handle.readline()
        plus = handle.readline()
        quality = handle.readline()
        record_number += 1

        if not sequence or not plus or not quality:
            raise ValueError(
                "{} is truncated at FASTQ record {}."
                .format(path, record_number)
            )

        header = header.rstrip("\r\n")
        sequence = sequence.rstrip("\r\n")
        plus = plus.rstrip("\r\n")
        quality = quality.rstrip("\r\n")

        if not header.startswith("@"):
            raise ValueError(
                "{} record {} does not start with '@'."
                .format(path, record_number)
            )

        if not plus.startswith("+"):
            raise ValueError(
                "{} record {} has an invalid plus line."
                .format(path, record_number)
            )

        if len(sequence) != len(quality):
            raise ValueError(
                "{} record {} has sequence length {} but quality length {}."
                .format(path, record_number, len(sequence), len(quality))
            )

        if not sequence:
            raise ValueError(
                "{} record {} has an empty sequence."
                .format(path, record_number)
            )

        yield header, record_number


count = 0

with open_text(r1_path) as r1, open_text(r2_path) as r2:
    for left, right in zip_longest(
        records(r1, r1_path),
        records(r2, r2_path),
    ):
        if left is None or right is None:
            raise ValueError(
                "R1 and R2 contain different numbers of FASTQ records."
            )

        header1, number1 = left
        header2, number2 = right

        if number1 != number2:
            raise ValueError("Internal paired-record count mismatch.")

        name1 = normalize_name(header1)
        name2 = normalize_name(header2)

        if name1 != name2:
            raise ValueError(
                "Mate-name mismatch at record {}: '{}' versus '{}'."
                .format(number1, name1, name2)
            )

        count += 1

if count == 0:
    raise ValueError("FASTQ inputs contain zero read pairs.")

print(count)
PY
}

validate_existing_bam() {
    local sample="$1"
    local bam="$2"

    [[ -s "$bam" ]] || return 1
    [[ -s "${bam}.bai" ]] || return 1

    samtools quickcheck -v "$bam"

    local rg_count
    local sm_count
    local unmapped
    local secondary
    local supplementary
    local markdup_count

    rg_count=$(samtools view -H "$bam" | awk '$1=="@RG"{n++} END{print n+0}')
    sm_count=$(samtools view -H "$bam" | awk -v sm="SM:${sample}" '
        $1=="@RG" {
            for (i=2; i<=NF; i++) {
                if ($i==sm) n++
            }
        }
        END{print n+0}
    ')
    markdup_count=$(samtools view -H "$bam" | awk '
        $1=="@PG" {
            for (i=2; i<=NF; i++) {
                field=tolower($i)
                if (index(field, "markdup") > 0) {
                    n++
                    break
                }
            }
        }
        END{print n+0}
    ')

    unmapped=$(samtools view -c -f 4 "$bam")
    secondary=$(samtools view -c -f 256 "$bam")
    supplementary=$(samtools view -c -f 2048 "$bam")

    [[ "$rg_count" -ge 1 ]] || return 1
    [[ "$sm_count" -ge 1 ]] || return 1
    [[ "$markdup_count" -ge 1 ]] || return 1
    [[ "$unmapped" -eq 0 ]] || return 1
    [[ "$secondary" -eq 0 ]] || return 1
    [[ "$supplementary" -eq 0 ]] || return 1
}

############################################
# VALIDATE SAMPLE LIST BEFORE MAPPING
############################################
python3 - "$SAMPLE_LIST" <<'PY'
import sys
from pathlib import Path

path = Path(sys.argv[1])
seen = set()
count = 0

with path.open() as handle:
    for line_number, line in enumerate(handle, start=1):
        stripped = line.strip()

        if not stripped or stripped.startswith("#"):
            continue

        fields = stripped.split()

        if len(fields) != 3:
            raise SystemExit(
                "ERROR: {} line {} has {} fields; expected exactly "
                "SAMPLE R1 R2."
                .format(path, line_number, len(fields))
            )

        sample = fields[0]

        if sample in seen:
            raise SystemExit(
                "ERROR: duplicate sample '{}' in {}."
                .format(sample, path)
            )

        seen.add(sample)
        count += 1

if count == 0:
    raise SystemExit("ERROR: no samples found in {}.".format(path))

print("Validated {} sample-list entries.".format(count))
PY

############################################
# MAP EACH SAMPLE
############################################
while read -r SAMPLE READ1 READ2 EXTRA; do
    [[ -z "${SAMPLE:-}" ]] && continue
    [[ "$SAMPLE" == \#* ]] && continue

    if [[ -n "${EXTRA:-}" ]]; then
        echo "ERROR: unexpected extra sample-list field for $SAMPLE." >&2
        exit 1
    fi

    validate_sample_name "$SAMPLE"

    READ1=$(realpath "$READ1")
    READ2=$(realpath "$READ2")

    for read_file in "$READ1" "$READ2"; do
        [[ -s "$read_file" ]] || {
            echo "ERROR: FASTQ missing or empty for $SAMPLE: $read_file" >&2
            exit 1
        }
    done

    BAMDIR="$RESULTS_DIR/$SAMPLE/bam"
    FINAL_BAM="$BAMDIR/$SAMPLE.mapped.bam"
    FINAL_BAI="${FINAL_BAM}.bai"
    QC_TSV="$BAMDIR/$SAMPLE.mapping_qc.tsv"
    BWA_LOG="$BAMDIR/$SAMPLE.bwa_mem.log"
    MARKDUP_STATS="$BAMDIR/$SAMPLE.markdup_stats.txt"
    COMMANDS_LOG="$BAMDIR/$SAMPLE.mapping_commands.log"

    mkdir -p "$BAMDIR"

    if [[ "$OVERWRITE" != "true" && -e "$FINAL_BAM" ]]; then
        if validate_existing_bam "$SAMPLE" "$FINAL_BAM"; then
            echo "Validated publication-format BAM exists for $SAMPLE; skipping."
            continue
        fi

        echo "ERROR: an existing BAM for $SAMPLE does not satisfy the revised" >&2
        echo "mapping contract. Set OVERWRITE=true to rebuild it." >&2
        exit 1
    fi

    echo "============================================================"
    echo "Processing sample: $SAMPLE"
    echo "R1: $READ1"
    echo "R2: $READ2"

    READ_PAIRS="NA"

    if [[ "$VALIDATE_FASTQ_PAIRS" == "true" ]]; then
        echo "Validating paired FASTQs..."
        READ_PAIRS=$(validate_fastq_pair "$READ1" "$READ2")
        echo "Validated read pairs: $READ_PAIRS"
    fi

    TMPDIR=$(mktemp -d "$BAMDIR/.map_${SAMPLE}.XXXXXX")
    trap 'rm -rf "$TMPDIR"' EXIT

    NAME_BAM="$TMPDIR/$SAMPLE.name_sorted.bam"
    FIXMATE_BAM="$TMPDIR/$SAMPLE.fixmate.bam"
    COORD_BAM="$TMPDIR/$SAMPLE.coordinate_sorted.bam"
    TMP_FINAL_BAM="$TMPDIR/$SAMPLE.mapped.bam"
    TMP_MARKDUP_STATS="$TMPDIR/$SAMPLE.markdup_stats.txt"
    TMP_BWA_LOG="$TMPDIR/$SAMPLE.bwa_mem.log"
    TMP_COMMANDS="$TMPDIR/$SAMPLE.mapping_commands.log"
    TMP_QC="$TMPDIR/$SAMPLE.mapping_qc.tsv"

    READ_GROUP="@RG\tID:${SAMPLE}\tSM:${SAMPLE}\tLB:${SAMPLE}\tPL:${DEFAULT_PLATFORM}"

    {
        echo "bwa mem -t $BWA_THREADS -R '$READ_GROUP' '$REF' '$READ1' '$READ2'"
        echo "samtools view -u -F $EXCLUDE_FLAGS"
        echo "samtools sort -n -@ $SORT_THREADS -m $SORT_MEMORY_PER_THREAD"
        echo "samtools fixmate -m -@ $SORT_THREADS"
        echo "samtools sort -@ $SORT_THREADS -m $SORT_MEMORY_PER_THREAD"
        echo "samtools markdup -@ $SORT_THREADS -s"
        echo "samtools index -@ $SORT_THREADS"
    } > "$TMP_COMMANDS"

    bwa mem \
        -t "$BWA_THREADS" \
        -R "$READ_GROUP" \
        "$REF" \
        "$READ1" \
        "$READ2" \
        2> "$TMP_BWA_LOG" \
    | samtools view \
        -@ 1 \
        -u \
        -F "$EXCLUDE_FLAGS" \
        - \
    | samtools sort \
        -n \
        -@ "$SORT_THREADS" \
        -m "$SORT_MEMORY_PER_THREAD" \
        -T "$TMPDIR/name_sort" \
        -o "$NAME_BAM" \
        -

    samtools fixmate \
        -m \
        -@ "$SORT_THREADS" \
        "$NAME_BAM" \
        "$FIXMATE_BAM"

    samtools sort \
        -@ "$SORT_THREADS" \
        -m "$SORT_MEMORY_PER_THREAD" \
        -T "$TMPDIR/coordinate_sort" \
        -o "$COORD_BAM" \
        "$FIXMATE_BAM"

    samtools markdup \
        -@ "$SORT_THREADS" \
        -s \
        -f "$TMP_MARKDUP_STATS" \
        "$COORD_BAM" \
        "$TMP_FINAL_BAM"

    samtools quickcheck -v "$TMP_FINAL_BAM"
    samtools index -@ "$SORT_THREADS" "$TMP_FINAL_BAM"

    MAPPED_PRIMARY=$(samtools view -c "$TMP_FINAL_BAM")
    DUPLICATE_READS=$(samtools view -c -f 1024 "$TMP_FINAL_BAM")
    NONDUPLICATE_READS=$(samtools view -c -F 1024 "$TMP_FINAL_BAM")
    MAPQ20_NONDUP=$(samtools view -c -q 20 -F 1024 "$TMP_FINAL_BAM")
    PROPER_PAIR_NONDUP=$(samtools view -c -f 2 -F 1024 "$TMP_FINAL_BAM")
    MATE_UNMAPPED_NONDUP=$(samtools view -c -f 8 -F 1024 "$TMP_FINAL_BAM")
    UNMAPPED=$(samtools view -c -f 4 "$TMP_FINAL_BAM")
    SECONDARY=$(samtools view -c -f 256 "$TMP_FINAL_BAM")
    SUPPLEMENTARY=$(samtools view -c -f 2048 "$TMP_FINAL_BAM")

    if [[ "$MAPPED_PRIMARY" -eq 0 ]]; then
        echo "ERROR: zero primary mapped reads for $SAMPLE." >&2
        exit 1
    fi

    if [[ "$UNMAPPED" -ne 0 || "$SECONDARY" -ne 0 || "$SUPPLEMENTARY" -ne 0 ]]; then
        echo "ERROR: final BAM contains excluded alignment classes for $SAMPLE." >&2
        exit 1
    fi

    RG_COUNT=$(samtools view -H "$TMP_FINAL_BAM" | awk '$1=="@RG"{n++} END{print n+0}')
    SM_COUNT=$(samtools view -H "$TMP_FINAL_BAM" | awk -v sm="SM:${SAMPLE}" '
        $1=="@RG" {
            for (i=2; i<=NF; i++) {
                if ($i==sm) n++
            }
        }
        END{print n+0}
    ')

    if [[ "$RG_COUNT" -lt 1 || "$SM_COUNT" -lt 1 ]]; then
        echo "ERROR: read-group sample identity was not preserved for $SAMPLE." >&2
        exit 1
    fi

    TOTAL_READ_SEGMENTS="NA"
    MAPPING_RATE="NA"

    if [[ "$READ_PAIRS" != "NA" ]]; then
        TOTAL_READ_SEGMENTS=$((READ_PAIRS * 2))
        MAPPING_RATE=$(awk -v m="$MAPPED_PRIMARY" -v t="$TOTAL_READ_SEGMENTS" '
            BEGIN {printf "%.10f", 100*m/t}
        ')
    fi

    DUPLICATE_PERCENT=$(awk -v d="$DUPLICATE_READS" -v m="$MAPPED_PRIMARY" '
        BEGIN {
            if (m > 0) printf "%.10f", 100*d/m
            else print "NA"
        }
    ')

    {
        printf "sample\tread1\tread2\tinput_read_pairs\tinput_read_segments\t"
        printf "primary_mapped_read_segments\tmapping_rate_percent\t"
        printf "duplicate_read_segments\tduplicate_percent_of_mapped\t"
        printf "nonduplicate_mapped_read_segments\tmapq20_nonduplicate_read_segments\t"
        printf "proper_pair_nonduplicate_read_segments\t"
        printf "mate_unmapped_nonduplicate_read_segments\t"
        printf "read_group_count\tread_group_SM_count\tbam_file\n"

        printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n" \
            "$SAMPLE" \
            "$READ1" \
            "$READ2" \
            "$READ_PAIRS" \
            "$TOTAL_READ_SEGMENTS" \
            "$MAPPED_PRIMARY" \
            "$MAPPING_RATE" \
            "$DUPLICATE_READS" \
            "$DUPLICATE_PERCENT" \
            "$NONDUPLICATE_READS" \
            "$MAPQ20_NONDUP" \
            "$PROPER_PAIR_NONDUP" \
            "$MATE_UNMAPPED_NONDUP" \
            "$RG_COUNT" \
            "$SM_COUNT" \
            "$FINAL_BAM"
    } > "$TMP_QC"

    # Finalize atomically after all checks pass.
    rm -f "$FINAL_BAM" "$FINAL_BAI" "$QC_TSV" "$BWA_LOG" \
        "$MARKDUP_STATS" "$COMMANDS_LOG"

    mv "$TMP_FINAL_BAM" "$FINAL_BAM"
    mv "${TMP_FINAL_BAM}.bai" "$FINAL_BAI"
    mv "$TMP_QC" "$QC_TSV"
    mv "$TMP_BWA_LOG" "$BWA_LOG"
    mv "$TMP_MARKDUP_STATS" "$MARKDUP_STATS"
    mv "$TMP_COMMANDS" "$COMMANDS_LOG"

    rm -rf "$TMPDIR"
    trap - EXIT

    echo "Finished: $SAMPLE"
    echo "Primary mapped segments: $MAPPED_PRIMARY"
    echo "Duplicate segments:      $DUPLICATE_READS"
    echo "MAPQ>=20 nonduplicates:  $MAPQ20_NONDUP"

done < "$SAMPLE_LIST"

echo
echo "All listed samples completed publication-format mapping."
